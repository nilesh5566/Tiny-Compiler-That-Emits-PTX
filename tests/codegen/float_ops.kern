// RUN: -O0
// Explicit .rn rounding everywhere: ptxas may not contract these into FMA.
// CHECK: add.rn.f32
// CHECK: sub.rn.f32
// CHECK: mul.rn.f32
// CHECK: div.rn.f32
// CHECK: neg.f32
kernel k(f32* o, f32 a, f32 b) {
    o[0] = a + b;
    o[1] = a - b;
    o[2] = a * b;
    o[3] = a / b;
    o[4] = -a;
}
