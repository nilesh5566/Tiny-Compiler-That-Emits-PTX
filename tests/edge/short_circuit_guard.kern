// The classic guard: `i < n && a[i] ...` must never read a[i] when i >= n.
// LAUNCH: kernel=k grid=1 block=8
// ARG: i32buf 5 values(3,-1,4,-1,5)
// ARG: i32buf 8 zeros
// ARG: i32 5
// EXPECT: arg1[0] == 1
// EXPECT: arg1[1] == 0
// EXPECT: arg1[7] == 0
kernel k(i32* a, i32* o, i32 n) {
    let i = gid();
    if (i < n && a[i] > 0) {
        o[i] = 1;
    }
    if (i >= n || a[i] < 0) {
        o[i] = o[i] + 0;
    }
}
