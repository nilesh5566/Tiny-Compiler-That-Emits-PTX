// Number of Collatz steps for start = gid() + 1 (integer-heavy, data-dependent loops)
kernel collatz(i32* steps, i32 n) {
    let i = gid();
    if (i >= n) { return; }
    let x = i + 1;
    let count = 0;
    while (x != 1 && count < 1000) {
        if (x % 2 == 0) {
            x = x / 2;
        } else {
            x = 3 * x + 1;
        }
        count = count + 1;
    }
    steps[i] = count;
}
